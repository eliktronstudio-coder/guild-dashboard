# Copy to .env.local. Never commit real environment files.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact trusted origin; no trailing slash. localhost only for local development.
APP_ORIGIN=http://localhost:3000
# Enable ONLY after testing the real provider / email delivery.
AUTH_TELEGRAM_ENABLED=false
AUTH_TELEGRAM_PROVIDER=custom:telegram
AUTH_EMAIL_ENABLED=false
AUTH_EMAIL_DELIVERY_READY=false
