# Copy to .env.local. Never commit real environment files.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact trusted origin; no trailing slash. localhost only for local development.
APP_ORIGIN=http://localhost:3000
# Enable Telegram after testing the real provider.
# Open email registration needs migration 022 and SUPABASE_SECRET_KEY (no SMTP required).
AUTH_TELEGRAM_ENABLED=false
AUTH_TELEGRAM_PROVIDER=custom:telegram
AUTH_EMAIL_ENABLED=false
# Enable mail recovery only after verifying a real mail provider.
AUTH_EMAIL_DELIVERY_READY=false

# Optional Telegram notification bot; separate from AUTH_TELEGRAM_* login.
# Server-only. Configure production scope; never paste values into GitHub/chat.
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
SUPABASE_SECRET_KEY=
# Optional scheduled delivery endpoint, at least 32 random characters.
CRON_SECRET=
# Optional Mini App at /mini-app; enable after migration 012 and bot setup.
TELEGRAM_MINI_APP_ENABLED=false
