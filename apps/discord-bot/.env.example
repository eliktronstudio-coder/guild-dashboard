# Shared with the website; generated on the server, never paste in chat.
DISCORD_IMPORT_SECRET=
XD_SITE_ORIGIN=https://xd-guild.ru
XD_DISCORD_STATE=/var/lib/xd-discord-bot
# The Discord Bot token, server and channel are configured by an administrator
# at /admin/discord. The token is encrypted in the private database schema.

# Worker only: /etc/xd-discord-bot.env (root:root 0600). Never commit real keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_DAILY_LIMIT=20
OPENAI_CONCURRENCY=2
OPENAI_MONTHLY_BUDGET_USD=5
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_OUTPUT_TOKENS=8192
OPENAI_CACHE_DAYS=30
OPENAI_BUDGET_TIMEZONE=Asia/Yekaterinburg

# Optional Render transport. In this mode OPENAI_API_KEY is required only on Render.
VISION_SERVICE_URL=
VISION_SERVICE_SECRET=
# Default timeout is 120000 ms in remote mode to allow Free instance cold starts.
